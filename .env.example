# Copy to `.env` for local development. Never commit real secrets.

# development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Local infra (docker compose) — Nest does not consume these in S0 ---
# Defaults match docker-compose.yml (dev only).

# Postgres 16
DATABASE_URL=postgresql://factosys:factosys@localhost:5432/factosys

# Redis 7
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=factosys
MINIO_SECRET_KEY=factosysdev
MINIO_BUCKET=factosys-dev
MINIO_CONSOLE_URL=http://localhost:9001

# --- Spike A / S1-SIGN (optional; ephemeral PFX used if unset) ---
# SPIKE_CERT_PATH=./certs/dev.pfx
# SPIKE_CERT_PASSWORD=
