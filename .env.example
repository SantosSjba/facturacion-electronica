# Copy to `.env` for local development. Never commit real secrets.

# development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Local infra (docker compose) ---
# Defaults match docker-compose.yml (dev only). Nest validates DATABASE_URL (S3-DB).

# Postgres 16
DATABASE_URL=postgresql://factosys:factosys@localhost:5433/factosys

# Redis 7
REDIS_URL=redis://localhost:6379

# Auth (S3-AUTH) — change secrets in any non-local environment
JWT_ACCESS_SECRET=dev-only-change-me-jwt-access-secret-32b
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
RATE_LIMIT_RPM_DEFAULT=120
RATE_LIMIT_LOGIN_RPM=10
RATE_LIMIT_SIGNUP_RPM=5
RATE_LIMIT_FORGOT_RPM=3

# Browser origins (landing :4321, saas-web :5174)
CORS_ORIGINS=http://localhost:4321,http://localhost:5174

# Optional: when set, POST /saas/public/signup-requests requires captcha_token
# CAPTCHA_SECRET=

# S13-NOTIF email (default log = sandbox, no external provider)
EMAIL_DRIVER=log
EMAIL_FROM=Factosys <noreply@factosys.local>
NOTIFICATIONS_OPS_EMAIL=platform@factosys.local
# S14-APR / S15-ONB invite links
SAAS_WEB_PUBLIC_URL=http://localhost:5174
INVITE_TOKEN_TTL_HOURS=72
# RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=factosys
MINIO_SECRET_KEY=factosysdev
MINIO_BUCKET=factosys-dev
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL_SEC=300
MINIO_CONSOLE_URL=http://localhost:9001

# SUNAT BillService: fake (CI/dev) | beta
SUNAT_BILL_MODE=fake

# Representación impresa (PDF): fake (stub CI) | playwright (RI HTML real)
# Con playwright: `pnpm --filter @factosys/pdf-ri exec playwright install chromium`
PDF_RI_MODE=playwright

# Envelope encryption for credentials (base64 32 bytes) — change in non-local envs
CREDENTIALS_MASTER_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# --- Spike A / S1-SIGN (optional; ephemeral PFX used if unset) ---
# SPIKE_CERT_PATH=./certs/dev.pfx
# SPIKE_CERT_PASSWORD=
