{
  "name": "@factosys/api",
  "version": "0.0.0",
  "private": true,
  "description": "Factosys electronic invoicing HTTP API (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@factosys/db": "workspace:*",
    "@factosys/domain": "workspace:*",
    "@factosys/shared": "workspace:*",
    "@factosys/sunat-sign": "workspace:*",
    "@factosys/sunat-soap": "workspace:*",
    "@factosys/sunat-gre": "workspace:*",
    "@factosys/sunat-ubl": "workspace:*",
    "@factosys/pdf-ri": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^12.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/argon2": "^0.15.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
