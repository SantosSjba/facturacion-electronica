---
import { docsUrl } from "../lib/site";

const credentials = [
  {
    title: "URL base de la API",
    body: "El endpoint de tu entorno (p. ej. https://api.factosys.pe). Todas las rutas /v1 viven bajo esa URL.",
    env: "FACTOSYS_BASE_URL",
  },
  {
    title: "API key (Bearer)",
    body: "Token por empresa. Va en Authorization: Bearer …. Con scopes e Idempotency-Key en emisiones.",
    env: "FACTOSYS_API_KEY",
  },
  {
    title: "Secret de webhook",
    body: "Secreto HMAC al crear el endpoint. Tu sistema web valida la firma de cada notificación de estado.",
    env: "FACTOSYS_WEBHOOK_SECRET",
  },
];

const capabilities = [
  {
    title: "Facturas y boletas",
    body: "Emite CPE (01/03) con validación, firma y seguimiento del CDR.",
  },
  {
    title: "Notas y GRE",
    body: "Notas de crédito/débito y guías de remisión electrónica vía API.",
  },
  {
    title: "Desde tu sistema web",
    body: "Mismo patrón que APIs de facturación: URL + token. Sin embebido; llamas REST desde tu backend.",
  },
  {
    title: "Webhooks y PDF",
    body: "Notificaciones firmadas HMAC y representación impresa lista para tu ERP o tienda.",
  },
];

const snippet = `// En tu backend — solo HTTP, sin instalar paquetes Factosys
const res = await fetch(\`\${process.env.FACTOSYS_BASE_URL}/v1/invoices\`, {
  method: "POST",
  headers: {
    Authorization: \`Bearer \${process.env.FACTOSYS_API_KEY}\`,
    "Idempotency-Key": \`inv-\${Date.now()}\`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify(payload), // factura.json
});
const doc = await res.json(); // 201 → { id, status, ... }`;
---


<section id="api" class="bg-gray-50">
  <div class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
    <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-600">
        API de facturación
      </p>
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-gray-900 md:text-4xl">
        Integra como con cualquier API de CPE
      </h2>
      <p class="font-light text-gray-500 sm:text-xl">
        No hace falta descargar un SDK: es REST + JSON. Configuras URL, API key
        (Bearer) y, si usas callbacks, el secret del webhook. Acceso por
        solicitud — aún sin compra self‑serve ni paquete público en npm.
      </p>
    </div>

    <div class="mb-10 grid gap-4 sm:grid-cols-3 lg:mb-12 lg:gap-6">
      {
        credentials.map((c) => (
          <div class="rounded-xl border border-brand-100 bg-white p-5 shadow-sm">
            <p class="mb-1 font-mono text-xs font-semibold text-brand-600">
              {c.env}
            </p>
            <h3 class="mb-2 text-base font-bold text-gray-900">{c.title}</h3>
            <p class="text-sm text-gray-500">{c.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mb-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        capabilities.map((c) => (
          <div class="rounded-xl border border-gray-200 bg-white p-5">
            <h3 class="mb-2 text-lg font-bold text-gray-900">{c.title}</h3>
            <p class="text-sm text-gray-500">{c.body}</p>
          </div>
        ))
      }
    </div>

    <div
      class="overflow-hidden rounded-xl border border-gray-800 bg-gray-900 shadow-lg"
    >
      <div
        class="flex items-center justify-between border-b border-gray-700 px-4 py-2"
      >
        <span class="text-xs font-medium text-gray-400">Node / fetch · REST puro</span>
        <a
          href={docsUrl}
          class="text-xs font-medium text-brand-400 hover:text-brand-300"
        >
          Ver documentación →
        </a>
      </div>
      <pre
        class="overflow-x-auto p-4 text-left text-sm leading-relaxed text-gray-100"
      ><code>{snippet}</code></pre>
    </div>
    <p class="mt-3 text-center text-xs text-gray-500">
      El helper <code class="rounded bg-gray-200 px-1">@factosys/sdk</code> existe
      solo en el monorepo (privado); no está publicado en npm. Integra con
      <code class="rounded bg-gray-200 px-1">curl</code>, Postman o el cliente HTTP
      de tu stack.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={docsUrl}
        class="inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-5 py-3 text-center text-sm font-medium text-white hover:bg-brand-600 focus:ring-4 focus:ring-brand-300 sm:w-auto"
      >
        Documentación facturación
      </a>
      <a
        href="#solicitud"
        class="inline-flex w-full items-center justify-center rounded-lg border border-gray-200 px-5 py-3 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 sm:w-auto"
      >
        Solicitar acceso (sin compra aún)
      </a>
    </div>
  </div>
</section>
