---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Factosys — Facturación electrónica" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Factosys — API de facturación electrónica SUNAT. Integra tu sistema con URL base, API key Bearer y secret de webhook. Acceso por solicitud."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
