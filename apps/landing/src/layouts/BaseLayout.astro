}

const { title = "Factosys — Facturación electrónica" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Factosys — plataforma de facturación electrónica SUNAT."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
