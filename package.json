{
  "name": "@factosys/facturacion-electronica",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @factosys/api start:dev",
    "dev:console": "pnpm --filter @factosys/console dev",
    "spike:sign": "pnpm --filter @factosys/sunat-sign exec tsx ./scripts/spike-sign.ts",
    "spike:ubl": "pnpm --filter @factosys/sunat-ubl exec tsx ./scripts/spike-ubl.ts",
    "spike:sendbill": "pnpm --filter @factosys/sunat-soap exec tsx ./scripts/spike-sendbill.ts",
    "sunat:unpack-schemas": "pnpm --filter @factosys/sunat-validation unpack-schemas",
    "sunat:unpack-xsl": "pnpm --filter @factosys/sunat-validation unpack-xsl",
    "validate:xml": "tsx ./packages/sunat-validation/scripts/validate-xml.ts",
    "validate:xsl": "node ./packages/sunat-validation/scripts/validate-xsl.mjs",
    "db:generate": "pnpm --filter @factosys/db generate",
    "db:migrate": "pnpm --filter @factosys/db migrate",
    "db:migrate:down": "pnpm --filter @factosys/db migrate:down",
    "db:seed": "pnpm --filter @factosys/db seed",
    "demo:api-mvp": "tsx ./scripts/demo-api-mvp.mjs",
    "verify:dod": "tsx ./scripts/verify-dod-producto.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "adm-zip": "^0.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "saxon-js": "^2.7.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "xslt3": "^2.7.0"
  }
}
