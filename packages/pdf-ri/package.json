{
  "name": "@factosys/pdf-ri",
  "version": "0.0.0",
  "private": true,
  "description": "Representaci\u00f3n impresa (PDF) renderer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true, force: true }); } catch {}\"",
    "test:print": "node scripts/verify-print.mjs",
    "test:gre-print": "tsx scripts/verify-gre-print.ts"
  },
  "dependencies": {
    "@factosys/shared": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
