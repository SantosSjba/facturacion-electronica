{
  "name": "@factosys/sunat-sign",
  "version": "0.0.0",
  "private": true,
  "description": "XMLDSig / XAdES signing (isolated from UBL builders)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true, force: true }); } catch {}\""
  },
  "dependencies": {
    "@factosys/shared": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.3.1"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
