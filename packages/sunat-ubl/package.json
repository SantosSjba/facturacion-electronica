{
  "name": "@factosys/sunat-ubl",
  "version": "0.0.0",
  "private": true,
  "description": "UBL Invoice/CreditNote builders (JSON → canonical XML without signature)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "testdata"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true, force: true }); } catch {}\""
  },
  "dependencies": {
    "@factosys/domain": "workspace:*",
    "@factosys/shared": "workspace:*",
    "@factosys/sunat-sign": "workspace:*",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
