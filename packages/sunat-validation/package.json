{
  "name": "@factosys/sunat-validation",
  "version": "0.0.0",
  "private": true,
  "description": "XSD / business-rule validation gate",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "unpack-schemas": "node ./scripts/unpack-schemas.mjs",
    "unpack-xsl": "node ./scripts/unpack-xsl.mjs",
    "validate:xml": "tsx ./scripts/validate-xml.ts",
    "validate:xsl": "node ./scripts/validate-xsl.mjs",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true, force: true }); } catch {}\""
  },
  "dependencies": {
    "@factosys/shared": "workspace:*",
    "@factosys/sunat-catalogs": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
